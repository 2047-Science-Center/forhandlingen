[Desktop Entry]
Version=1.0
Type=Application
Name=Uppdatera Förhandlingen
Comment=Hämta senaste versionen och ladda om stationen
# @EXEC@ ersätts av install-launcher.sh med rätt sökväg till update.sh.
# Terminal=true: man ska se vad som händer (och kunna skriva sudo-lösenord).
Exec=@EXEC@
Icon=software-update-available
Terminal=true
Categories=Game;
StartupNotify=false
