# systemd USER-tjänst: startar kiosk-fönstren i den grafiska sessionen.
# Installeras av install.sh till ~/.config/systemd/user/ (@REPO@ ersätts där).
# Kräver att NUC:en loggar in automatiskt till en X11-session (se NUC-INSTALL.md).
[Unit]
Description=Förhandlingen — kiosk (två skärmar)
After=graphical-session.target
PartOf=graphical-session.target

[Service]
Type=simple
ExecStart=@REPO@/deploy/nuc/kiosk.sh
Restart=always
RestartSec=3

[Install]
WantedBy=graphical-session.target
