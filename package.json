{
  "name": "forhandlingen",
  "version": "0.1.0",
  "private": true,
  "description": "Stationen Förhandlingen (X&Y-riggen) + gemensamt stations-kit — 2047 Science Center",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "build:relay": "VITE_RELAY_PATH=/ws vite build",
    "preview": "vite preview",
    "relay": "node server/relay.mjs",
    "serve": "npm run build:relay && node server/server.mjs",
    "start": "node server/server.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "vue-tsc --noEmit"
  },
  "dependencies": {
    "pinia": "^2.2.6",
    "vue": "^3.5.13",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@types/node": "^22.20.2",
    "@vitejs/plugin-vue": "^5.2.1",
    "typescript": "^5.7.2",
    "vite": "^6.0.5",
    "vitest": "^2.1.8",
    "vue-tsc": "^2.1.10"
  }
}
